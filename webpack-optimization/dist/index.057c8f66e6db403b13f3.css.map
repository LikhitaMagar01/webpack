.section .title{font-size:35px;padding-bottom:10px;color:#fff;font-family:"Dancing Script",cursive;font-optical-sizing:auto;font-weight:400}.section .description{font-size:18px;color:#fff;font-family:"Dancing Script",cursive;font-optical-sizing:auto;font-weight:400}
.container {
    max-height: 1000px;
    overflow: hidden;
    max-width: 100%;
}

.header {
    width: 90%;
    margin: 0 auto;
    padding: 20px 0;
}

.logo {
    border-radius: 50%;
    width: 10%;
}

.bg_image {
    width: 100%;
    height: 100vh;
    display: inline-block;
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    opacity: 90%;
}

.section {
    width: 30%;
    margin: 0 auto;
    position: absolute;
    bottom: 20px;
    left: 5%;
    font-weight: bold;
    background-color: rgba(0, 0, 0, 40%);
    padding: 15px;
}

.toast {
    width: 15%;
    position: absolute;
    bottom: 20px;
    right: 20px;
    background-color: rgba(0, 255, 0, 40%);
    color: #fff;
    padding: 10px;
    font-size: 18px;
    visibility: hidden;
}

.explore-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 10px 15px;
    background-color: #c511dd;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

.explore-btn:hover {
    background-color: #0056b3;
}

.header {
    width: 90%;
    margin: 0 auto;
    padding: 20px 0;
}

.unused-css {
    padding: 30px;
    margin: 10px;
}

